pragma language_version >= 0.16;

import CompactStandardLibrary;

export enum BoardState {
  VACANT,
  OCCUPIED
}

export ledger state: BoardState;
export ledger message: Maybe<Opaque<"string">>;
export ledger posterHash: Bytes<32>;
export ledger postCount: Counter;

constructor() {
  state = BoardState.VACANT;
  message = none<Opaque<"string">>();
}

witness localSecret(): Bytes<32>;

export circuit post(newMessage: Opaque<"string">): [] {
  assert(state == BoardState.VACANT, "Board is currently occupied");
  posterHash = disclose(persistentHash<Bytes<32>>(localSecret()));
  message = disclose(some<Opaque<"string">>(newMessage));
  state = BoardState.OCCUPIED;
  postCount.increment(1);
}

export circuit takeDown(): [] {
  assert(state == BoardState.OCCUPIED, "Board is currently vacant");
  assert(persistentHash<Bytes<32>>(localSecret()) == posterHash, "Only the original poster can take this down");
  state = BoardState.VACANT;
  message = none<Opaque<"string">>();
  posterHash = pad(32, "");
}
