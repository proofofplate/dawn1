# BIP39 mnemonic (24 words) — your testnet wallet seed
WALLET_SEED="word1 word2 word3 ... word24"

# Midnight Network (TestNet | DevNet | MainNet)
NETWORK_ID=TestNet

# Testnet endpoints (defaults already set in config.ts)
INDEXER=https://indexer.testnet-02.midnight.network/api/v1/graphql
INDEXER_WS=wss://indexer.testnet-02.midnight.network/api/v1/graphql/ws
MN_NODE=https://rpc.testnet-02.midnight.network

# Local proof server (start with: docker run -p 6300:6300 midnightntwrk/proof-server:latest)
PROOF_SERVER=http://localhost:6300
