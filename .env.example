# 24-word BIP39 mnemonic
WALLET_SEED="word1 word2 word3 ... word24"

# preprod | preview
NETWORK_ID=preprod

# local proof server (docker)
PROOF_SERVER=http://localhost:6300

# optional endpoint overrides
# INDEXER=https://indexer.preprod.midnight.network/api/v3/graphql
# INDEXER_WS=wss://indexer.preprod.midnight.network/api/v3/graphql/ws
# MN_NODE=https://rpc.preprod.midnight.network
# MN_NODE_WS=wss://rpc.preprod.midnight.network

# optional, for your own reference (never read by the code)
# WALLET_UNSHIELDED=mn_addr_preprod1...
# WALLET_SHIELDED=mn_shield-addr_preprod1...
# WALLET_DUST=mn_dust_preprod1...
